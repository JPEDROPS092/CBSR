# Copy to .env and adjust. Never commit a filled-in .env.
# Values shown are development defaults; every secret must be replaced.

# --- General ---------------------------------------------------------------
ENVIRONMENT=local              # local | test | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json                # json | console

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://ophthalmology:ophthalmology@postgres:5432/ophthalmology

# --- Cache / task queue ----------------------------------------------------
REDIS_URL=redis://redis:6379/0
TASK_QUEUE_BACKEND=celery      # inline (single process) | celery (workers)
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# --- Object storage --------------------------------------------------------
# Medical images are NEVER stored in PostgreSQL. Point this at S3, GCS or MinIO.
STORAGE_BACKEND=s3             # local (dev/test only) | s3
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=ophthalmology
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me
OBJECT_STORAGE_REGION=us-east-1
PRESIGNED_URL_TTL_SECONDS=900

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_BYTES=104857600

# --- AI runtime ------------------------------------------------------------
MODEL_DIR=/app/models
DEVICE=auto                    # auto | cpu | cuda
INFERENCE_PRECISION=fp32       # fp32 | fp16 | bf16 | int8
INFERENCE_BATCH_SIZE=1
QUALITY_GATE_ENABLED=true
QUALITY_GATE_MIN_SCORE=0.35
EXPLAINABILITY_ENABLED=true
