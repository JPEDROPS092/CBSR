    "scale_to_unit_interval": true,
    "notes": "Values copied from the model's own documentation. Do not guess these."
  },
  "output": {
    "segmentation_classes": [
      "background", "rnfl", "gcl_ipl", "inl", "opl", "onl", "is_os", "rpe"
    ],
    "activation": "softmax",
    "threshold": 0.5,
    "units": {"layer_thickness_um": "micrometre"}
  },
