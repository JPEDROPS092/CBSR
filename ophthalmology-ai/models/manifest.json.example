  "framework": "onnx",
  "weights_file": "layers_unet.onnx",
  "weights_sha256": null,
  "evidence_level": "research",
  "description": "Multi-class retinal layer segmentation on a single B-scan.",
  "input": {
    "image_size": [496, 512],
    "channels": 1,
    "color_space": "gray",
